2d:["$","div",null,{"className":"container-luxe max-w-[44rem] py-16","children":[["$","div",null,{"className":"flex flex-col","children":[["$","p","paragraph-0",{"className":"mt-5 text-[1.0625rem] leading-[1.75] text-mocha","children":"A shawl is one of the few wedding presents that is still in use twenty years later. It is also one of the easiest to get wrong, because the obvious choices — bright colours, heavy embroidery — are the ones that date fastest."}],["$","h2","heading-1",{"className":"mt-14 font-serif text-[1.625rem] leading-tight text-charcoal md:text-[2rem]","children":"For the bride"}],["$","p","paragraph-2",{"className":"mt-5 text-[1.0625rem] leading-[1.75] text-mocha","children":"Crimson and deep burgundy are traditional for bridal kani, and a full-field kani shawl is the most significant textile gift that exists in this part of the world. If the budget is not there, an ivory Pashmina with a tilla border does the same job: it reads as ceremonial without competing with the outfit."}],["$","$L15","productLink-3",{"href":"/products/crimson-bridal-kani-shawl","className":"group my-10 flex items-center justify-between gap-6 border border-line bg-cream/40 px-6 py-5 transition-colors duration-300 hover:border-gold/50","children":[["$","span",null,{"children":[["$","span",null,{"className":"eyebrow block text-gold","children":"Shop the piece"}],["$","span",null,{"className":"mt-1.5 block font-serif text-lg text-charcoal","children":"Crimson Bridal Kani Shawl"}]]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.25,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-4 w-4 shrink-0 text-charcoal transition-transform duration-500 ease-[var(--ease-luxe)] group-hover:translate-x-1","aria-hidden":true,"children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}],["$","h2","heading-4",{"className":"mt-14 font-serif text-[1.625rem] leading-tight text-charcoal md:text-[2rem]","children":"For the groom"}],["$","p","paragraph-5",{"className":"mt-5 text-[1.0625rem] leading-[1.75] text-mocha","children":"A plain charcoal or midnight Pashmina shawl, cut to men’s proportions, worn over a bandhgala. Undecorated is the point — it will be worn at every winter wedding for the rest of his life, which an embroidered piece will not."}],["$","h2","heading-6",{"className":"mt-14 font-serif text-[1.625rem] leading-tight text-charcoal md:text-[2rem]","children":"For the families"}],["$","p","paragraph-7",{"className":"mt-5 text-[1.0625rem] leading-[1.75] text-mocha","children":"Matched sets solve the hardest problem in wedding gifting, which is giving to two people at once without giving them the same thing. A shawl and stole dyed in a single bath read as a pair without being identical."}],["$","h2","heading-8",{"className":"mt-14 font-serif text-[1.625rem] leading-tight text-charcoal md:text-[2rem]","children":"What to spend"}],["$","ul","list-9",{"className":"mt-6 flex flex-col gap-3","children":[["$","li","Close family: ₹25,000 and above — kani, full sozni, or a numbered piece.",{"className":"flex items-start gap-3 text-[1.0625rem] leading-[1.7] text-mocha","children":[["$","span",null,{"aria-hidden":true,"className":"mt-3.5 h-px w-3.5 shrink-0 bg-gold"}],"Close family: ₹25,000 and above — kani, full sozni, or a numbered piece."]}],["$","li","Extended family and close friends: ₹10,000–20,000 — pure Pashmina, tilla border or plain.",{"className":"flex items-start gap-3 text-[1.0625rem] leading-[1.7] text-mocha","children":[["$","span",null,{"aria-hidden":true,"className":"mt-3.5 h-px w-3.5 shrink-0 bg-gold"}],"Extended family and close friends: ₹10,000–20,000 — pure Pashmina, tilla border or plain."]}],"$L32","$L33"]}],"$L34","$L35","$L36"]}],"$L37","$L38"]}]
