21:[["$","$L24",null,{"recommendations":[{"id":"ivory-heritage-pashmina-shawl","slug":"ivory-heritage-pashmina-shawl","name":"Ivory Heritage Pashmina Shawl","tagline":"The house classic, in undyed Ladakhi Pashmina.","description":"Our founding piece. Spun from fibre combed from Changthangi goats at 4,500 metres, hand-woven on a wooden handloom over six weeks, and finished with a whisper-fine sozni border in matching ivory thread.","story":["The Ivory Heritage is the shawl Pashmore was built on. It begins with raw pashm no thicker than a strand of mist — around 13 microns — combed by hand from the underfleece of Changthangi goats wintering on the Changthang plateau.","Because the fibre is left undyed, nothing hides the weave. Every pick of the weft is visible, which is why this piece is given to our most senior weavers and why no two ever leave the loom quite alike."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","pure-pashmina","heritage-collection","best-sellers","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Solid","patternSlug":"solid","craft":"Hand-spun, handwoven on a wooden handloom, sozni-finished border","price":8999,"compareAtPrice":12999,"currency":"INR","images":[{"url":"/images/products/ivory-heritage-pashmina-shawl-1.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/ivory-heritage-pashmina-shawl-2.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-heritage-pashmina-shawl-3.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-heritage-pashmina-shawl-4.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Ivory","slug":"ivory","hex":"#F3EDE2"},{"name":"Cream","slug":"cream","hex":"#E8DFD0"}],"sizes":[{"name":"Shawl — 100 × 200 cm","slug":"shawl-100x200","measurement":"100 × 200 cm"}],"variants":[{"id":"ivory-heritage-pashmina-shawl-ivory-shawl-100x200","sku":"PSH-IVORY--IVO-01","colorSlug":"ivory","sizeSlug":"shawl-100x200","price":8999,"compareAtPrice":12999,"inventory":6},{"id":"ivory-heritage-pashmina-shawl-cream-shawl-100x200","sku":"PSH-IVORY--CRE-02","colorSlug":"cream","sizeSlug":"shawl-100x200","price":8999,"compareAtPrice":12999,"inventory":6}],"inventory":12,"badges":["bestseller","handcrafted"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-spun, handwoven on a wooden handloom, sozni-finished border"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"100 × 200 cm"},{"label":"Weight","value":"180 g"},{"label":"Finish","value":"Hand-knotted fringe, 6 cm"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean only, using a specialist who handles fine cashmere.","Store folded in the muslin sleeve provided, never on a hanger.","Air for a few hours after wear rather than washing between uses.","Keep away from direct sunlight, perfume and jewellery that may snag the weave."],"countryOfOrigin":"India","publishedAt":"2026-01-12","popularity":98,"faqs":[{"question":"Is the Ivory Heritage Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.8,"count":214},"relatedSlugs":["kashmiri-sozni-embroidered-pashmina-shawl","warm-beige-ring-pashmina-shawl","soft-cream-ombre-pashmina-wrap"]},{"id":"warm-beige-ring-pashmina-shawl","slug":"warm-beige-ring-pashmina-shawl","name":"Warm Beige Ring Pashmina Shawl","tagline":"Fine enough to pass through a wedding ring.","description":"The classic test of Pashmina quality. Woven at a count fine enough that the entire shawl draws through a ring — and warm enough to make that seem impossible.","story":["The ring test is not a marketing invention; it is how buyers have judged pashm in Srinagar’s markets for generations.","Achieving it requires fibre under 14 microns, hand-spinning on a charkha and a weaver willing to work at half speed."],"gender":"women","categorySlug":"womens-pashmina","collectionSlugs":["womens-pashmina","womens-shawls","pashmina","pure-pashmina","heritage-collection","luxury-collection","best-sellers"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Solid","patternSlug":"solid","craft":"Charkha-spun pashm, ring-test certified","price":15999,"compareAtPrice":19999,"currency":"INR","images":[{"url":"/images/products/warm-beige-ring-pashmina-shawl-1.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/warm-beige-ring-pashmina-shawl-2.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/warm-beige-ring-pashmina-shawl-3.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, macro close-up