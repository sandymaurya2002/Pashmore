3a:["$","$L39","pure-pashmina-wedding-shawl-ivory-gold",{"product":{"id":"pure-pashmina-wedding-shawl-ivory-gold","slug":"pure-pashmina-wedding-shawl-ivory-gold","name":"Pure Pashmina Wedding Shawl in Ivory & Gold","tagline":"Made to be kept, and then given again.","description":"An ivory Pashmina ground with a wide gold tilla border, made for weddings and, eventually, for the next generation.","story":["In Kashmir a shawl is still part of a daughter’s trousseau. The ones that survive are almost always ivory — the ground that never dates.","Supplied with an archival muslin sleeve and a certificate recording the weaver, the loom and the date it came off it."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","pure-pashmina","wedding-collection","wedding-gifts","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Tilla Work","patternSlug":"tilla","craft":"Hand-spun pashm with hand-couched tilla border","price":29999,"compareAtPrice":36999,"currency":"INR","images":[{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-1.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-2.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-3.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-4.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, styled over the shoulder on model","width":800,"height":1000,"isPrimary":