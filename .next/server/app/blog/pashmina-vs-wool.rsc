36:["$","$L35","walnut-brown-mens-wool-shawl",{"product":{"id":"walnut-brown-mens-wool-shawl","slug":"walnut-brown-mens-wool-shawl","name":"Walnut Brown Men’s Wool Shawl","tagline":"Kashmiri handloom wool, brushed soft.","description":"A substantial handloom wool shawl in walnut brown, brushed twice to raise a soft nap that improves with wear.","story":["This is the cloth Kashmiri men actually wear through winter: heavier than Pashmina, more forgiving, and made to last a lifetime.","The colour is named for the walnut trees that line the road to Pampore, whose husks once supplied the dye."],"gender":"men","categorySlug":"mens-shawls","collectionSlugs":["mens-shawls","fine-wool","heritage-collection","gifts-for-him"],"material":"Handloom Wool","materialSlug":"handloom-wool","pattern":"Solid","patternSlug":"solid","craft":"Kashmiri handloom, double-brushed finish","price":5999,"compareAtPrice":7499,"currency":"INR","images":[{"url":"/images/products/walnut-brown-mens-wool-shawl-1.png","alt":"Pashmore men's walnut brown men’s wool shawl in walnut brown, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/walnut-brown-mens-wool-shawl-2.png","alt":"Pashmore men's walnut brown men’s wool shawl in walnut brown, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/walnut-brown-mens-wool-shawl-3.png","alt":"Pashmore men's walnut brown men’s wool shawl in walnut brown, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/walnut-brown-mens-wool-shawl-4.png","alt":"Pashmore men's walnut brown men’s wool shawl in walnut brown, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:3:colors:2","$21:0:props:recommendations:3:colors:0",{"name":"Olive","slug":"olive","hex":"#6E6F4E"}],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":