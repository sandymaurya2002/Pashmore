2a:Td44,{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"https://www.pashmore.com/products/soft-cream-ombre-pashmina-wrap#product","name":"Soft Cream Ombré Pashmina Wrap","description":"A generously cut wrap, dip-dyed by hand so the colour moves from cream at one end to warm sand at the other.","sku":"PSH-SOFT-C-CRE-01","mpn":"soft-cream-ombre-pashmina-wrap","url":"https://www.pashmore.com/products/soft-cream-ombre-pashmina-wrap","image":["https://www.pashmore.com/images/products/soft-cream-ombre-pashmina-wrap-1.png","https://www.pashmore.com/images/products/soft-cream-ombre-pashmina-wrap-2.png","https://www.pashmore.com/images/products/soft-cream-ombre-pashmina-wrap-3.png","https://www.pashmore.com/images/products/soft-cream-ombre-pashmina-wrap-4.png"],"brand":{"@type":"Brand","name":"Pashmore"},"manufacturer":{"@id":"https://www.pashmore.com/#organization"},"material":"Pure Pashmina","pattern":"Ombré","keywords":"soft cream ombré pashmina wrap, pure pashmina wrap, ombré wrap, cream wrap, wrap for women, ladies wrap, pashmina wrap, pure pashmina, kashmiri pashmina, pashmeena, kashmiri ombré, buy wrap online, kashmiri wrap, handwoven in kashmir, pashmore","countryOfOrigin":"India","category":"womens-shawls","color":"Cream, Sand","offers":{"@type":"Offer","url":"https://www.pashmore.com/products/soft-cream-ombre-pashmina-wrap","priceCurrency":"INR","price":13499,"availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition","seller":{"@id":"https://www.pashmore.com/#organization"},"priceValidUntil":"2027-10-08","hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":"IN","returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow","merchantReturnDays":14,"returnMethod":"https://schema.org/ReturnByMail","returnFees":"https://schema.org/FreeReturn"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":19,"bestRating":5,"worstRating":1}},{"@type":"Breadcrumb