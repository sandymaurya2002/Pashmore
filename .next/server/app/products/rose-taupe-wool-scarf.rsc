collectionSlugs":["womens-scarves","scarves","pashmina","new-arrivals","gifts-for-her"],"material":"Pashmina Silk Blend","materialSlug":"pashmina-silk","pattern":"Solid","patternSlug":"solid","craft":"Pashm warp with mulberry silk weft","price":4999,"compareAtPrice":"$undefined","currency":"INR","images":[{"url":"/images/products/ivory-silk-pashmina-blend-scarf-1.png","alt":"Pashmore women's ivory silk pashmina blend scarf in ivory, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/ivory-silk-pashmina-blend-scarf-2.png","alt":"Pashmore women's ivory silk pashmina blend scarf in ivory, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-silk-pashmina-blend-scarf-3.png","alt":"Pashmore women's ivory silk pashmina blend scarf in ivory, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-silk-pashmina-blend-scarf-4.png","alt":"Pashmore women's ivory silk pashmina blend scarf in ivory, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:0:colors:0","$21:0:props:recommendations:1:colors:1"],"sizes":[{"name":"Scarf — 50 × 180 cm","slug":"scarf-50x180","measurement":"50 × 180 cm"}],"variants":[{"id":"ivory-silk-pashmina-blend-scarf-ivory-scarf-50x180","sku":"PSH-IVORY--IVO-01","colorSlug":"ivory","sizeSlug":"scarf-50x180","price":4999,"compareAtPrice":"$undefined","inventory":17},{"id":"ivory-silk-pashmina-blend-scarf-sand-scarf-50x180","sku":"PSH-IVORY--SAN-02","colorSlug":"sand","sizeSlug":"scarf-50x180","price":4999,"compareAtPrice":"$undefined","inventory":17}],"inventory":34,"badges":["new"],"specifications":[{"label":"Material","value":"Pashmina Silk Blend"},{"label":"Weave / Craft","value":"Pashm warp with mulberry silk weft"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"50 × 180 cm"},{"label":"Weight","value":"110 g"},{"label":"Finish","value":"Hand-rolled edge"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean only.","Fold along the natural grain and rest in the muslin sleeve provided.","Steam lightly from a distance; never press the embroidery directly.","Avoid contact with water, which can mark the silk weft."],"countryOfOrigin":"India","publishedAt":"2026-04-08","popularity":70,"faqs":[{"question":"Is the Ivory Silk Pashmina Blend Scarf handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":"$undefined","relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":false}],"$L38","$L39","$L3a"]}]]}]
