34:["$","div",null,{"className":"mt-9","children":["$","$L3c",null,{"product":{"id":"rose-taupe-wool-scarf","slug":"rose-taupe-wool-scarf","name":"Rose Taupe Wool Scarf","tagline":"A soft neutral that flatters every skin tone.","description":"A finely brushed merino scarf in a dusty rose-taupe, brushed on one face only so it holds shape at the neck.","story":["Single-face brushing is an old finishing trick: the brushed side traps warmth against the skin while the flat side keeps the scarf from bulking under a coat collar.","The colour was matched to a fragment of hand-dyed cloth in our Srinagar archive."],"gender":"women","categorySlug":"womens-scarves","collectionSlugs":["womens-scarves","scarves","fine-wool","gifts-for-her"],"material":"Fine Merino Wool","materialSlug":"fine-wool","pattern":"Solid","patternSlug":"solid","craft":"Single-face brushed merino","price":2999,"compareAtPrice":3999,"currency":"INR","images":"$2c:props:children:0:props:children:props:images","colors":[{"name":"Dusty Rose","slug":"rose","hex":"#C0999A"},"$21:0:props:recommendations:2:colors:1"],"sizes":["$2d:props:children:1:props:children:0:props:product:sizes:0"],"variants":[{"id":"rose-taupe-wool-scarf-rose-scarf-50x180","sku":"PSH-ROSE-T-ROS-01","colorSlug":"rose","sizeSlug":"scarf-50x180","price":2999,"compareAtPrice":3999,"inventory":23},{"id":"rose-taupe-wool-scarf-taupe-scarf-50x180","sku":"PSH-ROSE-T-TAU-02","colorSlug":"taupe","sizeSlug":"scarf-50x180","price":2999,"compareAtPrice":3999,"inventory":23}],"inventory":46,"badges":[],"specifications":[{"label":"Material","value":"Fine Merino Wool"},{"label":"Weave / Craft","value":"Single-face brushed merino"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"50 × 180 cm"},{"label":"Weight","value":"120 g"},{"label":"Finish","value":"Hand-rolled edge"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean recommended.","Spot clean minor marks with a damp cloth and allow to air dry.","Steam to release creases rather than ironing directly.","Store folded in a breathable cotton bag."],"countryOfOrigin":"India","publishedAt":"2025-12-06","popularity":66,"faqs":[{"question":"Is the Rose Taupe Wool Scarf handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.5,"count":92},"relatedSlugs":"$undefined"}}]}]
