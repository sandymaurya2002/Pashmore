2a:Tc9b,{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"https://www.pashmore.com/products/rose-taupe-wool-scarf#product","name":"Rose Taupe Wool Scarf","description":"A finely brushed merino scarf in a dusty rose-taupe, brushed on one face only so it holds shape at the neck.","sku":"PSH-ROSE-T-ROS-01","mpn":"rose-taupe-wool-scarf","url":"https://www.pashmore.com/products/rose-taupe-wool-scarf","image":["https://www.pashmore.com/images/products/rose-taupe-wool-scarf-1.png","https://www.pashmore.com/images/products/rose-taupe-wool-scarf-2.png","https://www.pashmore.com/images/products/rose-taupe-wool-scarf-3.png","https://www.pashmore.com/images/products/rose-taupe-wool-scarf-4.png"],"brand":{"@type":"Brand","name":"Pashmore"},"manufacturer":{"@id":"https://www.pashmore.com/#organization"},"material":"Fine Merino Wool","pattern":"Solid","keywords":"rose taupe wool scarf, fine merino wool scarf, solid scarf, dusty rose scarf, scarf for women, ladies scarf, buy scarf online, kashmiri scarf, handwoven in kashmir, pashmore","countryOfOrigin":"India","category":"womens-scarves","color":"Dusty Rose, Warm Taupe","offers":{"@type":"Offer","url":"https://www.pashmore.com/products/rose-taupe-wool-scarf","priceCurrency":"INR","price":2999,"availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition","seller":{"@id":"https://www.pashmore.com/#organization"},"priceValidUntil":"2027-10-08","hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":"IN","returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow","merchantReturnDays":14,"returnMethod":"https://schema.org/ReturnByMail","returnFees":"https://schema.org/FreeReturn"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.5,"reviewCount":92,"bestRating":5,"worstRating":1}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Collections","item":"https://www.pashmore.com/collections"},{"@type":"ListItem","position":3,"name":"Women's Scarves","item":"https://www.pashmore.com/collections/womens-scarves"},{"@type":"ListItem","position":4,"name":"Rose Taupe Wool Scarf","item":"https://www.pashmore.com/products/rose-taupe-wool-scarf"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the Rose Taupe Wool Scarf handmade?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."}},{"@type":"Question","name":"How do I know the Pashmina is genuine?","acceptedAnswer":{"@type":"Answer","text":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."}},{"@type":"Question","name":"Can I return it if the colour is not what I expected?","acceptedAnswer":{"@type":"Answer","text":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}}]}]}5:[["$","script",null,{"id":"product-rose-taupe-wool-scarf","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2a"}}],"$L2b","$L2c","$L2d","$L2e"]
