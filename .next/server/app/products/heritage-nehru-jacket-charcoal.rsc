2a:Td1c,{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"https://www.pashmore.com/products/heritage-nehru-jacket-charcoal#product","name":"Heritage Nehru Jacket in Charcoal","description":"A structured Nehru jacket cut from handloom wool, fully lined in cotton silk, with hand-worked buttonholes and horn buttons.","sku":"PSH-HERITA-CHA-01","mpn":"heritage-nehru-jacket-charcoal","url":"https://www.pashmore.com/products/heritage-nehru-jacket-charcoal","image":["https://www.pashmore.com/images/products/heritage-nehru-jacket-charcoal-1.png","https://www.pashmore.com/images/products/heritage-nehru-jacket-charcoal-2.png","https://www.pashmore.com/images/products/heritage-nehru-jacket-charcoal-3.png","https://www.pashmore.com/images/products/heritage-nehru-jacket-charcoal-4.png"],"brand":{"@type":"Brand","name":"Pashmore"},"manufacturer":{"@id":"https://www.pashmore.com/#organization"},"material":"Handloom Wool","pattern":"Solid","keywords":"heritage nehru jacket in charcoal, handloom wool shawl, solid shawl, charcoal shawl, shawl for men, mens shawl, buy shawl online, kashmiri shawl, handwoven in kashmir, pashmore","countryOfOrigin":"India","category":"mens-jackets","color":"Charcoal, Midnight Blue","offers":{"@type":"Offer","url":"https://www.pashmore.com/products/heritage-nehru-jacket-charcoal","priceCurrency":"INR","price":18999,"availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition","seller":{"@id":"https://www.pashmore.com/#organization"},"priceValidUntil":"2027-10-08","hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":"IN","returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow","merchantReturnDays":14,"returnMethod":"https://schema.org/ReturnByMail","returnFees":"https://schema.org/FreeReturn"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":33,"bestRating":5,"worstRating":1}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Collections","item":"https://www.pashmore.com/collections"},{"@type":"ListItem","position":3,"name":"Men's Jackets","item":"https://www.pashmore.com/collections/mens-jackets"},{"@type":"ListItem","position":4,"name":"Heritage Nehru Jacket in Charcoal","item":"https://www.pashmore.com/products/heritage-nehru-jacket-charcoal"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the Heritage Nehru Jacket in Charcoal handmade?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."}},{"@type":"Question","name":"How do I know the Pashmina is genuine?","acceptedAnswer":{"@type":"Answer","text":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."}},{"@type":"Question","name":"Can I return it if the colour is not what I expected?","acceptedAnswer":{"@type":"Answer","text":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}}]}]}5:[["$","script",null,{"id":"product-heritage-nehru-jacket-charcoal","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2a"}}],"$L2b","$L2c","$L2d","$L2e"]
