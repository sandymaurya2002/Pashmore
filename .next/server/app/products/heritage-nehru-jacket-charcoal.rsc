39:["$","$L37","burgundy-kani-weave-pashmina-shawl",{"product":{"id":"burgundy-kani-weave-pashmina-shawl","slug":"burgundy-kani-weave-pashmina-shawl","name":"Burgundy Kani Weave Pashmina Shawl","tagline":"Woven thread by thread on wooden kanis.","description":"Kani weaving builds the pattern into the cloth itself, using dozens of small wooden bobbins instead of a shuttle. A single line of weft can take a full day.","story":["The kani technique survives in a handful of villages around Kanihama, outside Srinagar. Weavers work from a coded pattern called a talim, a script that has been passed down for generations and can only be read by those trained in it.","Deep burgundy is the traditional ground for bridal kani, offset here with an antique gold pallav at either end."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","kashmiri-collection","wedding-collection","luxury-collection","heritage-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Kani Weave","patternSlug":"kani","craft":"Hand-woven kani technique from a talim pattern script","price":47999,"compareAtPrice":59999,"currency":"INR","images":[{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-1.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-2.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-3.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-4.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Burgundy","slug":"burgundy","hex":"#5C2233"},{"name":"Crimson","slug":"crimson","hex":"#83282E"}],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":"burgundy-kani-weave-pashmina-shawl-burgundy-shawl-110x220","sku":"PSH-BURGUN-BUR-01","colorSlug":"burgundy","sizeSlug":"shawl-110x220","price":47999,"compareAtPrice":59999,"inventory":2},{"id":"burgundy-kani-weave-pashmina-shawl-crimson-shawl-110x220","sku":"PSH-BURGUN-CRI-02","colorSlug":"crimson","sizeSlug":"shawl-110x220","price":47999,"compareAtPrice":59999,"inventory":0}],"inventory":2,"badges":["exclusive","handcrafted","limited"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-woven kani technique from a talim pattern script"},{"label":"Pattern","value":"Kani Weave"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"250 g"},{"label":"Finish","value":"Hand-rolled edge with gold pallav"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$21:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-02-14","popularity":90,"faqs":[{"question":"Is the Burgundy Kani Weave Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"ra