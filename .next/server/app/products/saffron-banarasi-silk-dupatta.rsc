38:["$","$L37","ivory-chikankari-dupatta",{"product":{"id":"ivory-chikankari-dupatta","slug":"ivory-chikankari-dupatta","name":"Ivory Chikankari Dupatta","tagline":"Lucknowi shadow-work, in ivory on ivory.","description":"Chikankari worked tone-on-tone so the pattern appears and disappears with the light. Thirty-two stitch types are used across a single dupatta.","story":["Chikankari travelled from the Mughal court at Lucknow and remains the most restrained of India’s embroidery traditions — white thread on white cloth, read entirely through texture.","The shadow-work stitch, bakhiya, is worked from the reverse so the motif shows through the cloth as a soft haze."],"gender":"women","categorySlug":"womens-dupattas","collectionSlugs":["womens-dupattas","heritage-collection","new-arrivals"],"material":"Cotton Silk","materialSlug":"cotton-silk","pattern":"Chikankari","patternSlug":"chikankari","craft":"Hand-embroidered Lucknowi chikankari, 32 stitch types","price":5499,"compareAtPrice":6999,"currency":"INR","images":[{"url":"/images/products/ivory-chikankari-dupatta-1.png","alt":"Pashmore women's ivory chikankari dupatta in ivory, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/ivory-chikankari-dupatta-2.png","alt":"Pashmore women's ivory chikankari dupatta in ivory, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-chikankari-dupatta-3.png","alt":"Pashmore women's ivory chikankari dupatta in ivory, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-chikankari-dupatta-4.png","alt":"Pashmore women's ivory chikankari dupatta in ivory, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:0:colors:0","$21:0:props:recommendations:0:colors:1"],"sizes":["$2d:props:children:1:props:children:0:props:product:sizes:0"],"varian