2a:Td0e,{"@context":"https://schema.org","@graph":[{"@type":"Product","@id":"https://www.pashmore.com/products/saffron-banarasi-silk-dupatta#product","name":"Saffron Banarasi Silk Dupatta","description":"Pure Banarasi silk with a real zari border, woven on a jacquard handloom in Varanasi over three weeks.","sku":"PSH-SAFFRO-SAF-01","mpn":"saffron-banarasi-silk-dupatta","url":"https://www.pashmore.com/products/saffron-banarasi-silk-dupatta","image":["https://www.pashmore.com/images/products/saffron-banarasi-silk-dupatta-1.png","https://www.pashmore.com/images/products/saffron-banarasi-silk-dupatta-2.png","https://www.pashmore.com/images/products/saffron-banarasi-silk-dupatta-3.png","https://www.pashmore.com/images/products/saffron-banarasi-silk-dupatta-4.png"],"brand":{"@type":"Brand","name":"Pashmore"},"manufacturer":{"@id":"https://www.pashmore.com/#organization"},"material":"Banarasi Silk","pattern":"Jamawar","keywords":"saffron banarasi silk dupatta, banarasi silk dupatta, jamawar dupatta, saffron dupatta, dupatta for women, ladies dupatta, kashmiri jamawar, buy dupatta online, kashmiri dupatta, handwoven in kashmir, pashmore","countryOfOrigin":"India","category":"womens-dupattas","color":"Saffron, Crimson","offers":{"@type":"Offer","url":"https://www.pashmore.com/products/saffron-banarasi-silk-dupatta","priceCurrency":"INR","price":12999,"availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition","seller":{"@id":"https://www.pashmore.com/#organization"},"priceValidUntil":"2027-10-08","hasMerchantReturnPolicy":{"@type":"MerchantReturnPolicy","applicableCountry":"IN","returnPolicyCategory":"https://schema.org/MerchantReturnFiniteReturnWindow","merchantReturnDays":14,"returnMethod":"https://schema.org/ReturnByMail","returnFees":"https://schema.org/FreeReturn"}},"aggregateRating":{"@type":"AggregateRating","ratingValue":4.7,"reviewCount":51,"bestRating":5,"worstRating":1}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Collections","item":"https://www.pashmore.com/collections"},{"@type":"ListItem","position":3,"name":"Dupattas","item":"https://www.pashmore.com/collections/womens-dupattas"},{"@type":"ListItem","position":4,"name":"Saffron Banarasi Silk Dupatta","item":"https://www.pashmore.com/products/saffron-banarasi-silk-dupatta"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the Saffron Banarasi Silk Dupatta handmade?","acceptedAnswer":{"@type":"Answer","text":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."}},{"@type":"Question","name":"How do I know the Pashmina is genuine?","acceptedAnswer":{"@type":"Answer","text":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."}},{"@type":"Question","name":"Can I return it if the colour is not what I expected?","acceptedAnswer":{"@type":"Answer","text":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}}]}]}5:[["$","script",null,{"id":"product-saffron-banarasi-silk-dupatta","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2a"}}],"$L2b","$L2c","$L2d","$L2e"]
