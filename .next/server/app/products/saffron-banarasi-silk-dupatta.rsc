34:["$","div",null,{"className":"mt-9","children":["$","$L3c",null,{"product":{"id":"saffron-banarasi-silk-dupatta","slug":"saffron-banarasi-silk-dupatta","name":"Saffron Banarasi Silk Dupatta","tagline":"Handwoven zari from the looms of Varanasi.","description":"Pure Banarasi silk with a real zari border, woven on a jacquard handloom in Varanasi over three weeks.","story":["Banaras has woven figured silks since the Mughal period. Real zari — silver thread gilded with gold — is still made by a handful of families in the old city.","Saffron is the colour of auspicious beginnings across most of northern India, which is why this piece is so often bought for weddings."],"gender":"women","categorySlug":"womens-dupattas","collectionSlugs":["womens-dupattas","wedding-collection","luxury-collection","gifts-for-her"],"material":"Banarasi Silk","materialSlug":"banarasi-silk","pattern":"Jamawar","patternSlug":"jamawar","craft":"Jacquard handloom with real zari border","price":12999,"compareAtPrice":15999,"currency":"INR","images":"$2c:props:children:0:props:children:props:images","colors":[{"name":"Saffron","slug":"saffron","hex":"#C68F3F"},{"name":"Crimson","slug":"crimson","hex":"#83282E"}],"sizes":["$2d:props:children:1:props:children:0:props:product:sizes:0"],"variants":[{"id":"saffron-banarasi-silk-dupatta-saffron-dupatta-90x230","sku":"PSH-SAFFRO-SAF-01","colorSlug":"saffron","sizeSlug":"dupatta-90x230","price":12999,"compareAtPrice":15999,"inventory":4},{"id":"saffron-banarasi-silk-dupatta-crimson-dupatta-90x230","sku":"PSH-SAFFRO-CRI-02","colorSlug":"crimson","sizeSlug":"dupatta-90x230","price":12999,"compareAtPrice":15999,"inventory":4}],"inventory":8,"badges":["handcrafted"],"specifications":[{"label":"Material","value":"Banarasi Silk"},{"label":"Weave / Craft","value":"Jacquard handloom with real zari border"},{"label":"Pattern","value":"Jamawar"},{"label":"Dimensions","value":"90 × 230 cm"},{"label":"Weight","value":"320 g"},{"label":"Finish","value":"Zari border and pallav"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean only.","Wrap in muslin and store flat; refold along a different line each season.","Keep zari work away from moisture and perfume.","Never spray fragrance directly onto the fabric."],"countryOfOrigin":"India","publishedAt":"2026-02-26","popularity":76,"faqs":[{"question":"Is the Saffron Banarasi Silk Dupatta handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.7,"count":51},"relatedSlugs":"$undefined"}}]}]
