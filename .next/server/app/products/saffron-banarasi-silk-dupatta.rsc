f indigo and turmeric baths."],"gender":"women","categorySlug":"womens-dupattas","collectionSlugs":["womens-dupattas","kashmiri-collection","wedding-collection","gifts-for-her"],"material":"Cotton Silk","materialSlug":"cotton-silk","pattern":"Tilla Work","patternSlug":"tilla","craft":"Hand-couched tilla metallic thread embroidery","price":7999,"compareAtPrice":10999,"currency":"INR","images":[{"url":"/images/products/emerald-tilla-embroidered-dupatta-1.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/emerald-tilla-embroidered-dupatta-2.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/emerald-tilla-embroidered-dupatta-3.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/emerald-tilla-embroidered-dupatta-4.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Emerald","slug":"emerald","hex":"#2E5244"},{"name":"Burgundy","slug":"burgundy","hex":"#5C2233"}],"sizes":[{"name":"Dupatta — 90 × 230 cm","slug":"dupatta-90x230","measurement":"90 × 230 cm"}],"variants":[{"id":"emerald-tilla-embroidered-dupatta-emerald-dupatta-90x230","sku":"PSH-EMERAL-EME-01","colorSlug":"emerald","sizeSlug":"dupatta-90x230","price":7999,"compareAtPrice":10999,"inventory":7},{"id":"emerald-tilla-embroidered-dupatta-burgundy-dupatta-90x230","sku":"PSH-EMERAL-BUR-02","colorSlug":"burgundy","sizeSlug":"dupatta-90x230","price":7999,"compareAtPrice":10999,"inventory":7}],"inventory":14,"badges":["handcrafted"],"specifications":[{"label":"Material","value":"Cotton Silk"},{"label":"Weave / Craft","value":"Hand-couched tilla metallic thread embroidery"},{"label":"Pattern","value":"Tilla Work"},{"label":"Dimensions","value":"90 × 230 cm"},{"label":"Weight","value":"220 g"},{"label":"Finish","value":"Tilla-worked pallav at both ends"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean, or hand wash cold and separately for the first three washes.","Dry in shade to protect the natural dyes.","Press on a medium setting from the reverse side.","Store folded in a cotton bag."],"countryOfOrigin":"India","publishedAt":"2026-03-18","popularity":72,"faqs":[{"question":"Is the Emerald Tilla Embroidered Dupatta handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.6,"count":27},"relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":false}],"$L38","$L39","$L3a"]}]]}]
