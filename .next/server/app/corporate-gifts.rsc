28:T5d3,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.pashmore.com/corporate-gifts#webpage","url":"https://www.pashmore.com/corporate-gifts","name":"Corporate Gifting","description":"Corporate gifting in handwoven Indian cloth — from ten pieces upwards, individually boxed, with optional debossed branding and dispatch to multiple addresses.","isPartOf":{"@id":"https://www.pashmore.com/#website"},"inLanguage":"en-IN","about":{"@id":"https://www.pashmore.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Corporate Gifting","item":"https://www.pashmore.com/corporate-gifts"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the minimum order quantity?","acceptedAnswer":{"@type":"Answer","text":"Ten pieces. Larger volumes are quoted individually — contact our gifting desk with your recipient count and budget."}},{"@type":"Question","name":"Can we add our company logo?","acceptedAnswer":{"@type":"Answer","text":"Yes. We deboss logos onto the box lid and can weave a custom care label into each piece. Allow four weeks from artwork approval."}},{"@type":"Question","name":"Do you ship to multiple addresses?","acceptedAnswer":{"@type":"Answer","text":"Yes. Send a recipient list and we will dispatch individually, each with its own hand-written message card and no pricing in the parcel."}}]}]}5:[["$","script",null,{"id":"landing-corporate-gifts","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$28"}}],["$","section",null,{"className":"relative h-[38dvh] min-h-[16rem] w-full overflow-hidden bg-charcoal md:h-[44dvh]","children":[["$","$L23",null,{"src":"/images/banners/corporate-gifts.png","alt":"A row of individually boxed Pashmore stoles prepared for corporate dispatch","fill":true,"priority":true,"quality":80,"sizes":"100vw","className":"object-cover"}],["$","span",null,