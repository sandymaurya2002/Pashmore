-gifts"],"material":"Cashmere","materialSlug":"cashmere","pattern":"Solid","patternSlug":"solid","craft":"Four-ply cashmere, hand-rolled edge","price":6999,"compareAtPrice":"$undefined","currency":"INR","images":[{"url":"/images/products/slate-grey-mens-cashmere-stole-1.png","alt":"Pashmore men's slate grey men’s cashmere stole in slate grey, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/slate-grey-mens-cashmere-stole-2.png","alt":"Pashmore men's slate grey men’s cashmere stole in slate grey, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/slate-grey-mens-cashmere-stole-3.png","alt":"Pashmore men's slate grey men’s cashmere stole in slate grey, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/slate-grey-mens-cashmere-stole-4.png","alt":"Pashmore men's slate grey men’s cashmere stole in slate grey, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Slate Grey","slug":"slate","hex":"#6B7076"},"$21:0:props:recommendations:3:colors:0","$21:0:props:recommendations:3:colors:1"],"sizes":[{"name":"Stole — 70 × 200 cm","slug":"stole-70x200","measurement":"70 × 200 cm"}],"variants":[{"id":"slate-grey-mens-cashmere-stole-slate-stole-70x200","sku":"PSH-SLATE--SLA-01","colorSlug":"slate","sizeSlug":"stole-70x200","price":6999,"compareAtPrice":"$undefined","inventory":10},{"id":"slate-grey-mens-cashmere-stole-charcoal-stole-70x200","sku":"PSH-SLATE--CHA-02","colorSlug":"charcoal","sizeSlug":"stole-70x200","price":6999,"compareAtPrice":"$undefined","inventory":10},{"id":"slate-grey-mens-cashmere-stole-midnight-stole-70x200","sku":"PSH-SLATE--MID-03","colorSlug":"midnight","sizeSlug":"stole-70x200","price":6999,"compareAtPrice":"$undefined","inventory":10}],"inventory":30,"badges":[],"specifications":[{"label":"Material","value":"Cashmere"},{"label":"Weave / Craft","value":"Four-ply cashmere, hand-rolled edge"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"70 × 200 cm"},{"label":"Weight","value":"145 g"},{"label":"Finish","value":"Hand-rolled edge"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean, or hand wash cold with a pH-neutral cashmere detergent.","Reshape flat to dry away from heat and sunlight.","De-pill gently with a cashmere comb once per season.","Store folded with a cedar block to deter moths."],"countryOfOrigin":"India","publishedAt":"2026-01-22","popularity":62,"faqs":[{"question":"Is the Slate Grey Men’s Cashmere Stole handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.6,"count":58},"relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":true}],"$L30","$L31","$L32"]}]]}]
