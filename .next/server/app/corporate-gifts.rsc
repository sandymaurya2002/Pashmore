30:["$","$L2f","ink-blue-mens-wool-scarf",{"product":{"id":"ink-blue-mens-wool-scarf","slug":"ink-blue-mens-wool-scarf","name":"Ink Blue Men’s Wool Scarf","tagline":"A first scarf that lasts twenty winters.","description":"Fine merino in ink blue with a subtle self-coloured twill. Unfussy, hard-wearing and easy to give.","story":["Every wardrobe needs one entirely unremarkable scarf that works with everything. This is ours.","Woven in a 2/2 twill for durability and finished without fringe so it will not fray."],"gender":"men","categorySlug":"mens-scarves","collectionSlugs":["mens-scarves","scarves","fine-wool","gifts-for-him","corporate-gifts"],"material":"Fine Merino Wool","materialSlug":"fine-wool","pattern":"Herringbone","patternSlug":"herringbone","craft":"2/2 twill merino, mill-finished","price":2499,"compareAtPrice":3299,"currency":"INR","images":[{"url":"/images/products/ink-blue-mens-wool-scarf-1.png","alt":"Pashmore men's ink blue men’s wool scarf in midnight blue, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/ink-blue-mens-wool-scarf-2.png","alt":"Pashmore men's ink blue men’s wool scarf in midnight blue, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ink-blue-mens-wool-scarf-3.png","alt":"Pashmore men's ink blue men’s wool scarf in midnight blue, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ink-blue-mens-wool-scarf-4.png","alt":"Pashmore men's ink blue men’s wool scarf in midnight blue, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:3:colors:1","$21:0:props:recommendations:3:colors:0","$29:props:children:1:props:children:0:props:product:colors:0"],"sizes":[{"name":"Scarf — 50 × 180 cm","slug":"scarf-50x180","measurement":"50 × 180 cm"}],"variants":[{"id":"ink-blue-mens-wool-scarf-midnight-scarf-5