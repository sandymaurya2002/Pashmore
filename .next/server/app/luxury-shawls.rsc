30:["$","$L2f","crimson-bridal-kani-shawl",{"product":{"id":"crimson-bridal-kani-shawl","slug":"crimson-bridal-kani-shawl","name":"Crimson Bridal Kani Shawl","tagline":"Two years on the loom.","description":"A full-field kani shawl in bridal crimson. Woven by two weavers working the same loom in shifts for close to two years.","story":["Full-field kani is the most demanding textile made anywhere in India. The talim for this design runs to over four thousand coded lines.","Only a handful leave our workshop each year, and each is registered by number."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","kashmiri-collection","wedding-collection","luxury-collection","heritage-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Kani Weave","patternSlug":"kani","craft":"Full-field kani weave from a four-thousand-line talim","price":89999,"compareAtPrice":"$undefined","currency":"INR","images":[{"url":"/images/products/crimson-bridal-kani-shawl-1.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/crimson-bridal-kani-shawl-2.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/crimson-bridal-kani-shawl-3.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/crimson-bridal-kani-shawl-4.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$29:props:children:1:props:children:1:props:product:colors:1","$29:props:children:1:props:children:1:props:product:colors:0"],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":"crimson-bridal-kani-shawl-crimson-shawl-110x220","sku":"PSH-CRIMSO-CRI-01","colorSlug":"crimson","sizeSlug":"shawl-110x220","price":89999,"compareAtPrice":"$undefined","inventory":1},{"id":"crimson-bridal-kani-shawl-burgundy-shawl-110x220","sku":"PSH-CRIMSO-BUR-02","colorSlug":"burgundy","sizeSlug":"shawl-110x220","price":89999,"compareAtPrice":"$undefined","inventory":0}],"inventory":1,"badges":["exclusive","limited","handcrafted"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Full-field kani weave from a four-thousand-line talim"},{"label":"Pattern","value":"Kani Weave"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"270 g"},{"label":"Finish","value":"Numbered and registered, presentation box"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$21:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-03-22","popularity":80,"faqs":[{"question":"Is the Crimson Bridal Kani Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":5,"count":7},"relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":false}]
