28:T68a,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.pashmore.com/luxury-shawls#webpage","url":"https://www.pashmore.com/luxury-shawls","name":"Luxury Shawls","description":"The most demanding work we make — full-field kani, complete sozni embroidery and numbered pieces that occupy a loom for months. Handmade in Kashmir.","isPartOf":{"@id":"https://www.pashmore.com/#website"},"inLanguage":"en-IN","about":{"@id":"https://www.pashmore.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Luxury Shawls","item":"https://www.pashmore.com/luxury-shawls"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Why does a kani shawl cost so much more than an embroidered one?","acceptedAnswer":{"@type":"Answer","text":"Because the pattern is woven rather than applied. A kani weaver builds the design thread by thread with dozens of wooden bobbins, producing about a centimetre of finished cloth per day. Two weavers can spend two years on a single shawl."}},{"@type":"Question","name":"Do you take commissions?","acceptedAnswer":{"@type":"Answer","text":"Yes, a small number each year. Lead times run from six months to two years depending on technique. Contact our atelier to discuss a piece."}},{"@type":"Question","name":"Will a luxury shawl hold its value?","acceptedAnswer":{"@type":"Answer","text":"Well-documented handwoven kani and full sozni pieces have historically held value and are regularly passed down. We register every piece by number so provenance can always be established."}}]}]}5:[["$","script",null,{"id":"landing-luxury-shawls","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$28"}}],["$","section",null,{"className":"relative h-[38dvh] min-h-[16rem] w-full overflow-hidden bg-charcoal md:h-[44dvh]","children":[["$","$L23",null,{"src":"/images/banners/luxury-collection.png","a