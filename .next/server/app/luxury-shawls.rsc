29:["$","section",null,{"className":"pb-20","aria-labelledby":"landing-products","children":[["$","div",null,{"className":"flex flex-wrap items-end gap-6 justify-between","children":[["$","div",null,{"className":"max-w-xl","children":["$undefined",["$","h2",null,{"id":"landing-products","className":"font-serif text-[2rem] leading-[1.1] text-charcoal md:text-[2.75rem]","children":"Shop Luxury Shawls"}],"$undefined"]}],["$","$L15",null,{"href":"/collections/luxury-collection","className":"group inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.18em] text-charcoal transition-colors duration-300 hover:text-gold","children":["View the full collection",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.25,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right h-3.5 w-3.5 transition-transform duration-500 ease-[var(--ease-luxe)] group-hover:translate-x-1","aria-hidden":"true","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}],["$","div",null,{"className":"grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 md:gap-x-6 md:gap-y-14 xl:grid-cols-4 mt-12","children":[["$","$L2f","kashmiri-sozni-embroidered-pashmina-shawl",{"product":"$21:0:props:recommendations:2","sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":true}],["$","$L2f","burgundy-kani-weave-pashmina-shawl",{"product":{"id":"burgundy-kani-weave-pashmina-shawl","slug":"burgundy-kani-weave-pashmina-shawl","name":"Burgundy Kani Weave Pashmina Shawl","tagline":"Woven thread by thread on wooden kanis.","description":"Kani weaving builds the pattern into the cloth itself, using dozens of small wooden bobbins instead of a shuttle. A single line of weft can take a full day.","story":["The kani technique survives in a handful of villages around Kanihama, outside Srinagar. Weavers work from a coded pattern called a talim, a script that has been passed down for generations and can only be read by those trained in it.","Deep burgundy is the traditional ground for bridal kani, offset here with an antique gold pallav at either end."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","kashmiri-collection","wedding-collection","luxury-collection","heritage-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Kani Weave","patternSlug":"kani","craft":"Hand-woven kani technique from a talim pattern script","price":47999,"compareAtPrice":59999,"currency":"INR","images":[{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-1.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-2.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-3.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/burgundy-kani-weave-pashmina-shawl-4.png","alt":"Pashmore women's burgundy kani weave pashmina shawl in burgundy, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Burgundy","slug":"burgundy","hex":"#5C2233"},{"name":"Crimson","slug":"crimson","hex":"#83282E"}],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":"burgundy-kani-weave-pashmina-shawl-burgundy-shawl-110x220","sku":"PSH-BURGUN-BUR-01","colorSlug":"burgundy","sizeSlug":"shawl-110x220","price":47999,"compareAtPrice":59999,"inventory":2},{"id":"burgundy-kani-weave-pashmina-shawl-crimson-shawl-110x220","sku":"PSH-BURGUN-CRI-02","colorSlug":"crimson","sizeSlug":"shawl-110x220","price":47999,"compareAtPrice":59999,"inventory":0}],"inventory":2,"badges":["exclusive","handcrafted","limited"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-woven kani technique from a talim pattern script"},{"label":"Pattern","value":"Kani Weave"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"250 g"},{"label":"Finish","value":"Hand-rolled edge with gold pallav"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$21:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-02-14","popularity":90,"faqs":[{"question":"Is the Burgundy Kani Weave Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":5,"count":18},"relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":true}],"$L30","$L31","$L32","$L33","$L34","$L35"]}]]}]
2a:["$","section",null,{"className":"border-t border-line bg-cream/40 py-20","children":["$","div",null,{"className":"container-luxe max-w-3xl","children":[["$","article","What you are paying for",{"className":"mt-14 first:mt-0","children":[["$","h2",null,{"className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"What you are paying for"}],[["$","p","Not branding and not packaging. ",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"Not branding and not packaging. On a full-field kani shawl, roughly 90% of the price is two weavers’ time across up to two years. On full sozni, it is one embroiderer covering about a square inch of ground per working day."}],["$","p","The fibre matters, but at this l",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"The fibre matters, but at this level labour dominates the cost entirely."}]],"$undefined"]}],["$","article","Provenance and registration",{"className":"mt-14 first:mt-0","children":[["$","h2",null,{"className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"Provenance and registration"}],[["$","p","Every piece in this collection i",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"Every piece in this collection is registered by number, photographed before dispatch and recorded against the weaver’s name. If you ever want it valued, restored or authenticated, that record is what makes it possible."}]],"$undefined"]}],["$","article","Made to order",{"className":"mt-14 first:mt-0","children":[["$","h2",null,{"className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"Made to order"}],[["$","p","We accept a small number of comm",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"We accept a small number of commissions each year — a specific talim, a particular ground colour, or a family motif worked into the border. Lead times run from six months for sozni to two years for full-field kani. Speak to us before the wedding season, not during it."}]],"$undefined"]}]]}]}]
2b:["$","section",null,{"className":"border-t border-line py-20","aria-labelledby":"landing-faqs","children":["$","div",null,{"className":"container-luxe max-w-3xl","children":[["$","h2",null,{"id":"landing-faqs","className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"Frequently Asked Questions"}],["$","$L36",null,{"type":"single","collapsible":true,"className":"mt-8","children":[["$","$L37","Why does a kani shawl cost so much more than an embroidered one?",{"value":"faq-0","children":[["$","$L38",null,{"children":"Why does a kani shawl cost so much more than an embroidered one?"}],["$","$L39",null,{"children":"Because the pattern is woven rather than applied. A kani weaver builds the design thread by thread with dozens of wooden bobbins, producing about a centimetre of finished cloth per day. Two weavers can spend two years on a single shawl."}]]}],["$","$L37","Do you take commissions?",{"value":"faq-1","children":[["$","$L38",null,{"children":"Do you take commissions?"}],["$","$L39",null,{"children":"Yes, a small number each year. Lead times run from six months to two years depending on technique. Contact our atelier to discuss a piece."}]]}],["$","$L37","Will a luxury shawl hold its value?",{"value":"faq-2","children":[["$","$L38",null,{"children":"Will a luxury shawl hold its value?"}],["$","$L39",null,{"children":"Well-documented handwoven kani and full sozni pieces have historically held value and are regularly passed down. We register every piece by number so provenance can always be established."}]]}]]}]]}]}]
