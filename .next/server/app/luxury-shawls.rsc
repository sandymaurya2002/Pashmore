34:["$","$L2f","antique-gold-jamawar-shawl",{"product":{"id":"antique-gold-jamawar-shawl","slug":"antique-gold-jamawar-shawl","name":"Antique Gold Jamawar Shawl","tagline":"A full-field jamawar in muted antique gold.","description":"Jamawar covers the entire ground with pattern rather than confining it to a border. This piece reads gold from a distance and reveals eight separate colours up close.","story":["Jamawar takes its name from the length of cloth — jama — needed to make a robe. Historically these shawls were traded as currency along the routes between Srinagar, Kabul and Isfahan.","The palette here is deliberately softened: antique gold rather than bright, so the piece sits comfortably with modern tailoring."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","kashmiri-collection","heritage-collection","wedding-collection","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Jamawar","patternSlug":"jamawar","craft":"Handwoven jamawar with multi-colour weft insertion","price":22999,"compareAtPrice":28999,"currency":"INR","images":[{"url":"/images/products/antique-gold-jamawar-shawl-1.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/antique-gold-jamawar-shawl-2.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/antique-gold-jamawar-shawl-3.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/antique-gold-jamawar-shawl-4.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Antique Gold","slug":"gold","hex":"#B08D4F"},"$21:0:props:recommendations:3:colors:2"],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":"antique-gold-jamawar-shawl-gold-shawl-110x220","sku":"PSH-ANTIQU-GOL-01","colorSlug":"gold","sizeSlug":"shawl-110x220","price":22999,"compareAtPrice":28999,"inventory":4},{"id":"antique-gold-jamawar-shawl-brown-shawl-110x220","sku":"PSH-ANTIQU-BRO-02","colorSlug":"brown","sizeSlug":"shawl-110x220","price":22999,"compareAtPrice":28999,"inventory":4}],"inventory":8,"badges":["limited","handcrafted"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Handwoven jamawar with multi-colour weft insertion"},{"label":"Pattern","value":"Jamawar"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"240 g"},{"label":"Finish","value":"Hand-knotted fringe"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$21:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-01-28","popularity":84,"faqs":[{"question":"Is the Antique Gold Jamawar Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.7,"count":44},"relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":false}]
