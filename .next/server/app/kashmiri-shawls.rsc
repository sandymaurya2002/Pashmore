33:["$","$L2f","emerald-tilla-embroidered-dupatta",{"product":{"id":"emerald-tilla-embroidered-dupatta","slug":"emerald-tilla-embroidered-dupatta","name":"Emerald Tilla Embroidered Dupatta","tagline":"Metallic tilla work on deep emerald.","description":"Tilla — flattened metallic thread — couched by hand into a scrolling border. Traditionally worn at Kashmiri weddings; cut here to work with contemporary suit sets.","story":["Tilla work is measured in tolas of thread rather than hours. This dupatta carries close to forty grams of it along the border and pallav.","Emerald is a colour Kashmiri dyers reserve for occasion cloth, drawn historically from a combination of indigo and turmeric baths."],"gender":"women","categorySlug":"womens-dupattas","collectionSlugs":["womens-dupattas","kashmiri-collection","wedding-collection","gifts-for-her"],"material":"Cotton Silk","materialSlug":"cotton-silk","pattern":"Tilla Work","patternSlug":"tilla","craft":"Hand-couched tilla metallic thread embroidery","price":7999,"compareAtPrice":10999,"currency":"INR","images":[{"url":"/images/products/emerald-tilla-embroidered-dupatta-1.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/emerald-tilla-embroidered-dupatta-2.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/emerald-tilla-embroidered-dupatta-3.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/emerald-tilla-embroidered-dupatta-4.png","alt":"Pashmore women's emerald tilla embroidered dupatta in emerald, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Emerald","slug":"emerald","hex":"#2