31:["$","$L2f","antique-gold-jamawar-shawl",{"product":{"id":"antique-gold-jamawar-shawl","slug":"antique-gold-jamawar-shawl","name":"Antique Gold Jamawar Shawl","tagline":"A full-field jamawar in muted antique gold.","description":"Jamawar covers the entire ground with pattern rather than confining it to a border. This piece reads gold from a distance and reveals eight separate colours up close.","story":["Jamawar takes its name from the length of cloth — jama — needed to make a robe. Historically these shawls were traded as currency along the routes between Srinagar, Kabul and Isfahan.","The palette here is deliberately softened: antique gold rather than bright, so the piece sits comfortably with modern tailoring."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","kashmiri-collection","heritage-collection","wedding-collection","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Jamawar","patternSlug":"jamawar","craft":"Handwoven jamawar with multi-colour weft insertion","price":22999,"compareAtPrice":28999,"currency":"INR","images":[{"url":"/images/products/antique-gold-jamawar-shawl-1.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/antique-gold-jamawar-shawl-2.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/antique-gold-jamawar-shawl-3.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/antique-gold-jamawar-shawl-4.png","alt":"Pashmore women's antique gold jamawar shawl in antique gold, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Antique Gold",