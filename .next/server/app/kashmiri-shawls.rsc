28:T6a0,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.pashmore.com/kashmiri-shawls#webpage","url":"https://www.pashmore.com/kashmiri-shawls","name":"Kashmiri Shawls","description":"Authentic Kashmiri shawls in sozni embroidery, kani weave, jamawar and tilla work — made in Srinagar by artisan families, with a craft certificate on every piece.","isPartOf":{"@id":"https://www.pashmore.com/#website"},"inLanguage":"en-IN","about":{"@id":"https://www.pashmore.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Kashmiri Shawls","item":"https://www.pashmore.com/kashmiri-shawls"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the difference between kani and sozni?","acceptedAnswer":{"@type":"Answer","text":"Kani is a weaving technique — the pattern is built into the cloth on the loom using small wooden bobbins. Sozni is embroidery worked with a needle onto cloth that is already woven. Kani is generally rarer and slower."}},{"@type":"Question","name":"Are Kashmiri shawls always Pashmina?","acceptedAnswer":{"@type":"Answer","text":"No. Kashmiri workshops weave Pashmina, fine merino and heavier handloom wool. The craft describes where and how it was made; Pashmina describes the fibre."}},{"@type":"Question","name":"What is a talim?","acceptedAnswer":{"@type":"Answer","text":"A coded pattern script used in kani weaving, in which each symbol represents a colour and a number of warp threads. It is read aloud in the workshop and can only be interpreted by someone trained in the notation."}}]}]}5:[["$","script",null,{"id":"landing-kashmiri-shawls","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$28"}}],["$","section",null,{"className":"relative h-[38dvh] min-h-[16rem] w-full overflow-hidden bg-charcoal md:h-[44dvh]","children":[["$","$L23",null,{"src":"/images/banners/kas