32:["$","$L2f","paisley-jamawar-womens-shawl",{"product":{"id":"paisley-jamawar-womens-shawl","slug":"paisley-jamawar-womens-shawl","name":"Paisley Jamawar Women’s Shawl","tagline":"The buta, in its original home.","description":"A jamawar shawl carrying the paisley — buta — motif in a repeating field, woven in warm taupe with eight weft colours.","story":["The paisley is not Scottish. It is the Kashmiri buta, copied in Paisley, Renfrewshire in the nineteenth century after European demand outran what Srinagar’s looms could supply.","This shawl returns the motif to its own vocabulary, at the scale and density it was originally woven in."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","kashmiri-collection","heritage-collection","best-sellers"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Paisley","patternSlug":"paisley","craft":"Handwoven jamawar, eight-colour weft","price":19999,"compareAtPrice":24999,"currency":"INR","images":[{"url":"/images/products/paisley-jamawar-womens-shawl-1.png","alt":"Pashmore women's paisley jamawar women’s shawl in warm taupe, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/paisley-jamawar-womens-shawl-2.png","alt":"Pashmore women's paisley jamawar women’s shawl in warm taupe, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/paisley-jamawar-womens-shawl-3.png","alt":"Pashmore women's paisley jamawar women’s shawl in warm taupe, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/paisley-jamawar-womens-shawl-4.png","alt":"Pashmore women's paisley jamawar women’s shawl in warm taupe, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:2:colors:1","$21:0:props:recommendations:3:colors:2","$31:props:product:colors:0"],"sizes":["$21:0:props