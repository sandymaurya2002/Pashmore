ni embroidered pashmina shawl in cream, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/kashmiri-sozni-embroidered-pashmina-shawl-3.png","alt":"Pashmore women's kashmiri sozni embroidered pashmina shawl in cream, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/kashmiri-sozni-embroidered-pashmina-shawl-4.png","alt":"Pashmore women's kashmiri sozni embroidered pashmina shawl in cream, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:0:colors:1",{"name":"Warm Taupe","slug":"taupe","hex":"#9C8A72"}],"sizes":[{"name":"Shawl — 110 × 220 cm","slug":"shawl-110x220","measurement":"110 × 220 cm"}],"variants":[{"id":"kashmiri-sozni-embroidered-pashmina-shawl-cream-shawl-110x220","sku":"PSH-KASHMI-CRE-01","colorSlug":"cream","sizeSlug":"shawl-110x220","price":34999,"compareAtPrice":44999,"inventory":2},{"id":"kashmiri-sozni-embroidered-pashmina-shawl-taupe-shawl-110x220","sku":"PSH-KASHMI-TAU-02","colorSlug":"taupe","sizeSlug":"shawl-110x220","price":34999,"compareAtPrice":44999,"inventory":0}],"inventory":2,"badges":["limited","handcrafted","exclusive"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-embroidered sozni needlework in silk thread"},{"label":"Pattern","value":"Sozni Embroidery"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"210 g"},{"label":"Finish","value":"Hand-rolled edge"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$21:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-02-02","popularity":92,"faqs":[{"question":"Is the Kashmiri Sozni Embroidered Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature