30:["$","$L2f","crimson-bridal-kani-shawl",{"product":{"id":"crimson-bridal-kani-shawl","slug":"crimson-bridal-kani-shawl","name":"Crimson Bridal Kani Shawl","tagline":"Two years on the loom.","description":"A full-field kani shawl in bridal crimson. Woven by two weavers working the same loom in shifts for close to two years.","story":["Full-field kani is the most demanding textile made anywhere in India. The talim for this design runs to over four thousand coded lines.","Only a handful leave our workshop each year, and each is registered by number."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","kashmiri-collection","wedding-collection","luxury-collection","heritage-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Kani Weave","patternSlug":"kani","craft":"Full-field kani weave from a four-thousand-line talim","price":89999,"compareAtPrice":"$undefined","currency":"INR","images":[{"url":"/images/products/crimson-bridal-kani-shawl-1.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/crimson-bridal-kani-shawl-2.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/crimson-bridal-kani-shawl-3.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/crimson-bridal-kani-shawl-4.png","alt":"Pashmore women's crimson bridal kani shawl in crimson, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$29:props:children:1:props:children:1:props:product:colors:1","$29:props:children:1:props:children:1:props:product:colors:0"],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":"crimson-bridal-