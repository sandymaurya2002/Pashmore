26:[["$","$L28",null,{"recommendations":[{"id":"ivory-heritage-pashmina-shawl","slug":"ivory-heritage-pashmina-shawl","name":"Ivory Heritage Pashmina Shawl","tagline":"The house classic, in undyed Ladakhi Pashmina.","description":"Our founding piece. Spun from fibre combed from Changthangi goats at 4,500 metres, hand-woven on a wooden handloom over six weeks, and finished with a whisper-fine sozni border in matching ivory thread.","story":["The Ivory Heritage is the shawl Pashmore was built on. It begins with raw pashm no thicker than a strand of mist — around 13 microns — combed by hand from the underfleece of Changthangi goats wintering on the Changthang plateau.","Because the fibre is left undyed, nothing hides the weave. Every pick of the weft is visible, which is why this piece is given to our most senior weavers and why no two ever leave the loom quite alike."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","pure-pashmina","heritage-collection","best-sellers","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Solid","patternSlug":"solid","craft":"Hand-spun, handwoven on a wooden handloom, sozni-finished border","price":8999,"compareAtPrice":12999,"currency":"INR","images":[{"url":"/images/products/ivory-heritage-pashmina-shawl-1.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/ivory-heritage-pashmina-shawl-2.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-heritage-pashmina-shawl-3.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/ivory-heritage-pashmina-shawl-4.png","alt":"Pashmore women's ivory heritage pashmina shawl in ivory, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Ivory","slug":"ivory","hex":"#F3EDE2"},{"name":"Cream","slug":"cream","hex":"#E8DFD0"}],"sizes":[{"name":"Shawl — 100 × 200 cm","slug":"shawl-100x200","measurement":"100 × 200 cm"}],"variants":[{"id":"ivory-heritage-pashmina-shawl-ivory-shawl-100x200","sku":"PSH-IVORY--IVO-01","colorSlug":"ivory","sizeSlug":"shawl-100x200","price":8999,"compareAtPrice":12999,"inventory":6},{"id":"ivory-heritage-pashmina-shawl-cream-shawl-100x200","sku":"PSH-IVORY--CRE-02","colorSlug":"cream","sizeSlug":"shawl-100x200","price":8999,"compareAtPrice":12999,"inventory":6}],"inventory":12,"badges":["bestseller","handcrafted"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-spun, handwoven on a wooden handloom, sozni-finished border"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"100 × 200 cm"},{"label":"Weight","value":"180 g"},{"label":"Finish","value":"Hand-knotted fringe, 6 cm"},{"label":"Country of Origin","value":"India"}],"careInstructions":["Dry clean only, using a specialist who handles fine cashmere.","Store folded in the muslin sleeve provided, never on a hanger.","Air for a few hours after wear rather than washing between uses.","Keep away from direct sunlight, perfume and jewellery that may snag the weave."],"countryOfOrigin":"India","publishedAt":"2026-01-12","popularity":98,"faqs":[{"question":"Is the Ivory Heritage Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.8,"count":214},"relatedSlugs":["kashmiri-sozni-embroidered-pashmina-shawl","warm-beige-ring-pashmina-shawl","soft-cream-ombre-pashmina-wrap"]},{"id":"warm-beige-ring-pashmina-shawl","slug":"warm-beige-ring-pashmina-shawl","name":"Warm Beige Ring Pashmina Shawl","tagline":"Fine enough to pass through a wedding ring.","description":"The classic test of Pashmina quality. Woven at a count fine enough that the entire shawl draws through a ring — and warm enough to make that seem impossible.","story":["The ring test is not a marketing invention; it is how buyers have judged pashm in Srinagar’s markets for generations.","Achieving it requires fibre under 14 microns, hand-spinning on a charkha and a weaver willing to work at half speed."],"gender":"women","categorySlug":"womens-pashmina","collectionSlugs":["womens-pashmina","womens-shawls","pashmina","pure-pashmina","heritage-collection","luxury-collection","best-sellers"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Solid","patternSlug":"solid","craft":"Charkha-spun pashm, ring-test certified","price":15999,"compareAtPrice":19999,"currency":"INR","images":[{"url":"/images/products/warm-beige-ring-pashmina-shawl-1.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/warm-beige-ring-pashmina-shawl-2.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/warm-beige-ring-pashmina-shawl-3.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/warm-beige-ring-pashmina-shawl-4.png","alt":"Pashmore women's warm beige ring pashmina shawl in beige, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Beige","slug":"beige","hex":"#C9B294"},{"name":"Sand","slug":"sand","hex":"#D8C7AE"},"$26:0:props:recommendations:0:colors:0"],"sizes":["$26:0:props:recommendations:0:sizes:0"],"variants":[{"id":"warm-beige-ring-pashmina-shawl-beige-shawl-100x200","sku":"PSH-WARM-B-BEI-01","colorSlug":"beige","sizeSlug":"shawl-100x200","price":15999,"compareAtPrice":19999,"inventory":3},{"id":"warm-beige-ring-pashmina-shawl-sand-shawl-100x200","sku":"PSH-WARM-B-SAN-02","colorSlug":"sand","sizeSlug":"shawl-100x200","price":15999,"compareAtPrice":19999,"inventory":3},{"id":"warm-beige-ring-pashmina-shawl-ivory-shawl-100x200","sku":"PSH-WARM-B-IVO-03","colorSlug":"ivory","sizeSlug":"shawl-100x200","price":15999,"compareAtPrice":19999,"inventory":3}],"inventory":9,"badges":["handcrafted","bestseller"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Charkha-spun pashm, ring-test certified"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"100 × 200 cm"},{"label":"Weight","value":"140 g"},{"label":"Finish","value":"Hand-knotted fringe"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$26:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-01-05","popularity":94,"faqs":[{"question":"Is the Warm Beige Ring Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.9,"count":128},"relatedSlugs":"$undefined"},{"id":"kashmiri-sozni-embroidered-pashmina-shawl","slug":"kashmiri-sozni-embroidered-pashmina-shawl","name":"Kashmiri Sozni Embroidered Pashmina Shawl","tagline":"Eighteen months of needlework, one shawl.","description":"A pure Pashmina ground carrying continuous sozni embroidery in a chinar-leaf trail. Worked with a single needle in silk thread so fine that the reverse of the shawl is as clean as the face.","story":["Sozni is the slowest of the Kashmiri needle crafts. A master embroiderer covers perhaps a square inch of ground on a good day, which is why a fully worked shawl can occupy one pair of hands for the better part of two years.","The chinar leaf running through this design is the emblem of the Kashmir valley — the same motif you will find carved into the walnut ceilings of Srinagar’s old houses."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","pure-pashmina","kashmiri-collection","heritage-collection","luxury-collection","wedding-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Sozni Embroidery","patternSlug":"sozni","craft":"Hand-embroidered sozni needlework in silk thread","price":34999,"compareAtPrice":44999,"currency":"INR","images":[{"url":"/images/products/kashmiri-sozni-embroidered-pashmina-shawl-1.png","alt":"Pashmore women's kashmiri sozni embroidered pashmina shawl in cream, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/kashmiri-sozni-embroidered-pashmina-shawl-2.png","alt":"Pashmore women's kashmiri sozni embroidered pashmina shawl in cream, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/kashmiri-sozni-embroidered-pashmina-shawl-3.png","alt":"Pashmore women's kashmiri sozni embroidered pashmina shawl in cream, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/kashmiri-sozni-embroidered-pashmina-shawl-4.png","alt":"Pashmore women's kashmiri sozni embroidered pashmina shawl in cream, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$26:0:props:recommendations:0:colors:1",{"name":"Warm Taupe","slug":"taupe","hex":"#9C8A72"}],"sizes":[{"name":"Shawl — 110 × 220 cm","slug":"shawl-110x220","measurement":"110 × 220 cm"}],"variants":[{"id":"kashmiri-sozni-embroidered-pashmina-shawl-cream-shawl-110x220","sku":"PSH-KASHMI-CRE-01","colorSlug":"cream","sizeSlug":"shawl-110x220","price":34999,"compareAtPrice":44999,"inventory":2},{"id":"kashmiri-sozni-embroidered-pashmina-shawl-taupe-shawl-110x220","sku":"PSH-KASHMI-TAU-02","colorSlug":"taupe","sizeSlug":"shawl-110x220","price":34999,"compareAtPrice":44999,"inventory":0}],"inventory":2,"badges":["limited","handcrafted","exclusive"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-embroidered sozni needlework in silk thread"},{"label":"Pattern","value":"Sozni Embroidery"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"210 g"},{"label":"Finish","value":"Hand-rolled edge"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$26:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-02-02","popularity":92,"faqs":[{"question":"Is the Kashmiri Sozni Embroidered Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.9,"count":61},"relatedSlugs":["ivory-heritage-pashmina-shawl","burgundy-kani-weave-pashmina-shawl","paisley-jamawar-womens-shawl"]},{"id":"classic-charcoal-mens-pashmina-shawl","slug":"classic-charcoal-mens-pashmina-shawl","name":"Classic Charcoal Men’s Pashmina Shawl","tagline":"The shawl to wear over a bandhgala.","description":"A men’s-proportioned pure Pashmina shawl in deep charcoal, cut longer and slightly narrower so it hangs cleanly from the shoulder.","story":["Men’s shawls in Kashmir are traditionally cut with more length and less width — the drape is meant to fall in two straight columns rather than wrap.","Undecorated, it becomes the quietest thing in the room and, usually, the most expensive."],"gender":"men","categorySlug":"mens-shawls","collectionSlugs":["mens-shawls","pashmina","pure-pashmina","best-sellers","gifts-for-him","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Solid","patternSlug":"solid","craft":"Hand-spun pashm, men’s proportion handloom weave","price":13999,"compareAtPrice":17999,"currency":"INR","images":[{"url":"/images/products/classic-charcoal-mens-pashmina-shawl-1.png","alt":"Pashmore men's classic charcoal men’s pashmina shawl in charcoal, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/classic-charcoal-mens-pashmina-shawl-2.png","alt":"Pashmore men's classic charcoal men’s pashmina shawl in charcoal, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/classic-charcoal-mens-pashmina-shawl-3.png","alt":"Pashmore men's classic charcoal men’s pashmina shawl in charcoal, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/classic-charcoal-mens-pashmina-shawl-4.png","alt":"Pashmore men's classic charcoal men’s pashmina shawl in charcoal, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":[{"name":"Charcoal","slug":"charcoal","hex":"#2E2C29"},{"name":"Midnight Blue","slug":"midnight","hex":"#1E2433"},{"name":"Walnut Brown","slug":"brown","hex":"#4E3D2E"}],"sizes":["$26:0:props:recommendations:2:sizes:0"],"variants":[{"id":"classic-charcoal-mens-pashmina-shawl-charcoal-shawl-110x220","sku":"PSH-CLASSI-CHA-01","colorSlug":"charcoal","sizeSlug":"shawl-110x220","price":13999,"compareAtPrice":17999,"inventory":6},{"id":"classic-charcoal-mens-pashmina-shawl-midnight-shawl-110x220","sku":"PSH-CLASSI-MID-02","colorSlug":"midnight","sizeSlug":"shawl-110x220","price":13999,"compareAtPrice":17999,"inventory":6},{"id":"classic-charcoal-mens-pashmina-shawl-brown-shawl-110x220","sku":"PSH-CLASSI-BRO-03","colorSlug":"brown","sizeSlug":"shawl-110x220","price":13999,"compareAtPrice":17999,"inventory":6}],"inventory":18,"badges":["bestseller","handcrafted"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-spun pashm, men’s proportion handloom weave"},{"label":"Pattern","value":"Solid"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"200 g"},{"label":"Finish","value":"Hand-knotted fringe"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$26:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2025-12-20","popularity":91,"faqs":[{"question":"Is the Classic Charcoal Men’s Pashmina Shawl handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.8,"count":87},"relatedSlugs":["walnut-brown-mens-wool-shawl","slate-grey-mens-cashmere-stole","heritage-nehru-jacket-charcoal"]}]}],"$L29","$L2a"]
