","children":"2011"}],["$","div",null,{"children":[["$","h3",null,{"className":"font-serif text-xl text-charcoal","children":"Kani returns to the workshop"}],["$","p",null,{"className":"mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-mocha","children":"After a long decline in the technique, we bring two kani weavers from Kanihama onto our own looms and begin recording talim scripts that had never been written down twice."}]]}]]}],["$","$L7","2019",{"as":"li","delay":0.18,"className":"grid gap-4 border-t border-line py-8 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-12","children":[["$","p",null,{"className":"font-serif text-2xl text-gold","children":"2019"}],["$","div",null,{"children":[["$","h3",null,{"className":"font-serif text-xl text-charcoal","children":"Every piece signed"}],["$","p",null,{"className":"mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-mocha","children":"We begin issuing a craft certificate with every shawl, naming the weaver, the loom and the date it came off it. It has been our single most requested change."}]]}]]}],["$","$L7","2026",{"as":"li","delay":0.24,"className":"grid gap-4 border-t border-line py-8 md:grid-cols-[8rem_minmax(0,1fr)] md:gap-12","children":[["$","p",null,{"className":"font-serif text-2xl text-gold","children":"2026"}],["$","div",null,{"children":[["$","h3",null,{"className":"font-serif text-xl text-charcoal","children":"Direct from Srinagar"}],["$","p",null,{"className":"mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-mocha","children":"Pashmore ships worldwide from the same workshop, with no intermediary between the weaver and the person who will wear the piece."}]]}]]}]]}]]}]}]
