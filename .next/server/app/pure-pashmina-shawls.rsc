y":false}],["$","$L2f","pure-pashmina-wedding-shawl-ivory-gold",{"product":{"id":"pure-pashmina-wedding-shawl-ivory-gold","slug":"pure-pashmina-wedding-shawl-ivory-gold","name":"Pure Pashmina Wedding Shawl in Ivory & Gold","tagline":"Made to be kept, and then given again.","description":"An ivory Pashmina ground with a wide gold tilla border, made for weddings and, eventually, for the next generation.","story":["In Kashmir a shawl is still part of a daughter’s trousseau. The ones that survive are almost always ivory — the ground that never dates.","Supplied with an archival muslin sleeve and a certificate recording the weaver, the loom and the date it came off it."],"gender":"women","categorySlug":"womens-shawls","collectionSlugs":["womens-shawls","womens-pashmina","pashmina","pure-pashmina","wedding-collection","wedding-gifts","luxury-collection"],"material":"Pure Pashmina","materialSlug":"pure-pashmina","pattern":"Tilla Work","patternSlug":"tilla","craft":"Hand-spun pashm with hand-couched tilla border","price":29999,"compareAtPrice":36999,"currency":"INR","images":[{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-1.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, photographed flat to show the full drape","width":800,"height":1000,"isPrimary":true},{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-2.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, detail view of the hand-finished border","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-3.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, macro close-up of the woven texture","width":800,"height":1000,"isPrimary":false},{"url":"/images/products/pure-pashmina-wedding-shawl-ivory-gold-4.png","alt":"Pashmore women's pure pashmina wedding shawl in ivory & gold in ivory, styled over the shoulder on model","width":800,"height":1000,"isPrimary":false}],"colors":["$21:0:props:recommendations:0:colors:0",{"name":"Antique Gold","slug":"gold","hex":"#B08D4F"}],"sizes":["$21:0:props:recommendations:2:sizes:0"],"variants":[{"id":"pure-pashmina-wedding-shawl-ivory-gold-ivory-shawl-110x220","sku":"PSH-PURE-P-IVO-01","colorSlug":"ivory","sizeSlug":"shawl-110x220","price":29999,"compareAtPrice":36999,"inventory":3},{"id":"pure-pashmina-wedding-shawl-ivory-gold-gold-shawl-110x220","sku":"PSH-PURE-P-GOL-02","colorSlug":"gold","sizeSlug":"shawl-110x220","price":29999,"compareAtPrice":36999,"inventory":0}],"inventory":3,"badges":["limited","handcrafted"],"specifications":[{"label":"Material","value":"Pure Pashmina"},{"label":"Weave / Craft","value":"Hand-spun pashm with hand-couched tilla border"},{"label":"Pattern","value":"Tilla Work"},{"label":"Dimensions","value":"110 × 220 cm"},{"label":"Weight","value":"230 g"},{"label":"Finish","value":"Wide tilla border, archival muslin sleeve"},{"label":"Country of Origin","value":"India"}],"careInstructions":"$21:0:props:recommendations:0:careInstructions","countryOfOrigin":"India","publishedAt":"2026-01-30","popularity":82,"faqs":[{"question":"Is the Pure Pashmina Wedding Shawl in Ivory & Gold handmade?","answer":"Yes. Every Pashmore piece is hand-spun, handwoven and hand-finished by artisan families in Kashmir. Small irregularities in the weave are the signature of handwork, not a defect."},{"question":"How do I know the Pashmina is genuine?","answer":"Each order ships with a craft certificate recording the fibre grade, the loom it was woven on and the name of the weaver who finished it."},{"question":"Can I return it if the colour is not what I expected?","answer":"Yes. Unused pieces in their original packaging can be returned within 14 days of delivery. Handwoven textiles photograph slightly differently under different light, so we make returns straightforward."}],"rating":{"average":4.9,"count":24},"relatedSlugs":"$undefined"},"sizes":"(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 45vw","priority":false}],"$L30","$L31"]}]]}]
2a:["$","section",null,{"className":"border-t border-line bg-cream/40 py-20","children":["$","div",null,{"className":"container-luxe max-w-3xl","children":[["$","article","Why blends exist at all",{"className":"mt-14 first:mt-0","children":[["$","h2",null,{"className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"Why blends exist at all"}],[["$","p","Blending is not always dishonest",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"Blending is not always dishonest. Adding mulberry silk to the weft has been standard practice in Kashmir for over a century — it produces a lighter, summer-weight cloth with a faint lustre, and it is sold openly as a Pashmina-silk blend."}],["$","p","The problem is blends sold as pu",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"The problem is blends sold as pure. A 70/30 wool-pashm cloth costs a fraction of pure pashm to produce and is very difficult to distinguish by eye. Documentation is the only real defence."}]],"$undefined"]}],["$","article","The ring test, honestly assessed",{"className":"mt-14 first:mt-0","children":[["$","h2",null,{"className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"The ring test, honestly assessed"}],[["$","p","A fine unembroidered shawl woven",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"A fine unembroidered shawl woven from sub-14-micron pashm will draw through a wedding ring. It is a genuine demonstration of fineness and it is how buyers have judged cloth in Srinagar’s markets for generations."}],["$","p","It is not proof of authenticity.",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"It is not proof of authenticity. A thin viscose scarf passes it easily, and a heavier embroidered Pashmina will not pass at all. Use it alongside touch, surface haze and paperwork."}]],"$undefined"]}],["$","article","What comes with every piece",{"className":"mt-14 first:mt-0","children":[["$","h2",null,{"className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"What comes with every piece"}],[["$","p","A craft certificate recording mi",{"className":"mt-5 text-[0.9375rem] leading-relaxed text-mocha","children":"A craft certificate recording micron grade, loom number and the weaver’s name; an archival muslin sleeve for storage; and a hand-bound presentation box."}]],"$undefined"]}]]}]}]
2b:["$","section",null,{"className":"border-t border-line py-20","aria-labelledby":"landing-faqs","children":["$","div",null,{"className":"container-luxe max-w-3xl","children":[["$","h2",null,{"id":"landing-faqs","className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"Frequently Asked Questions"}],["$","$L32",null,{"type":"single","collapsible":true,"className":"mt-8","children":[["$","$L33","What does \"pure Pashmina\" legally mean?",{"value":"faq-0","children":[["$","$L34",null,{"children":"What does \"pure Pashmina\" legally mean?"}],["$","$L35",null,{"children":"Under the Kashmir Pashmina Geographical Indication, the fibre must be Changthangi pashm and the hand-processing must take place in Kashmir. Certification follows laboratory fibre testing."}]]}],["$","$L33","Is a Pashmina-silk blend inferior?",{"value":"faq-1","children":[["$","$L34",null,{"children":"Is a Pashmina-silk blend inferior?"}],["$","$L35",null,{"children":"Not inferior, different. Silk in the weft gives lighter, more lustrous cloth that knots and drapes well — ideal for scarves and warm-weather layering. It is simply not pure Pashmina, and should never be sold as such."}]]}],["$","$L33","How long will a pure Pashmina shawl last?",{"value":"faq-2","children":[["$","$L34",null,{"children":"How long will a pure Pashmina shawl last?"}],["$","$L35",null,{"children":"Decades, with correct care. The pieces that fail early almost always do so through storage mistakes — hangers, plastic bags and direct sunlight — rather than wear."}]]}]]}]]}]}]
