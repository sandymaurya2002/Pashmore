28:T6a9,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.pashmore.com/pure-pashmina-shawls#webpage","url":"https://www.pashmore.com/pure-pashmina-shawls","name":"Pure Pashmina Shawls","description":"Certified pure Pashmina shawls — nothing blended, nothing substituted. Hand-combed Changthangi fibre, charkha-spun and handwoven in Kashmir.","isPartOf":{"@id":"https://www.pashmore.com/#website"},"inLanguage":"en-IN","about":{"@id":"https://www.pashmore.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Pure Pashmina Shawls","item":"https://www.pashmore.com/pure-pashmina-shawls"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What does \"pure Pashmina\" legally mean?","acceptedAnswer":{"@type":"Answer","text":"Under the Kashmir Pashmina Geographical Indication, the fibre must be Changthangi pashm and the hand-processing must take place in Kashmir. Certification follows laboratory fibre testing."}},{"@type":"Question","name":"Is a Pashmina-silk blend inferior?","acceptedAnswer":{"@type":"Answer","text":"Not inferior, different. Silk in the weft gives lighter, more lustrous cloth that knots and drapes well — ideal for scarves and warm-weather layering. It is simply not pure Pashmina, and should never be sold as such."}},{"@type":"Question","name":"How long will a pure Pashmina shawl last?","acceptedAnswer":{"@type":"Answer","text":"Decades, with correct care. The pieces that fail early almost always do so through storage mistakes — hangers, plastic bags and direct sunlight — rather than wear."}}]}]}5:[["$","script",null,{"id":"landing-pure-pashmina-shawls","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$28"}}],["$","section",null,{"className":"relative h-[38dvh] min-h-[16rem] w-full overflow-hidden bg-charcoal md:h-[44dvh]","children":[["$","$L23",null,{"src":"/images/banners/pure-pashmina.png","alt":"Undyed pure Pashmina cloth showing the hand-spun weave in close detail","fill":true,"priority":true,"quality":80,"sizes":"100vw","className":"object-cover"}],["$","span",null,{"aria-hidden":true,"className":"absolute inset-0 bg-ink/48"}],["$","div",null,{"className":"container-luxe relative flex h-full flex-col justify-end pb-10","children":[["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-5","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1.5 text-[0.6875rem] uppercase tracking-[0.12em]","children":[["$","li","/",{"className":"flex items-center gap-1.5","children":[["$","$L15",null,{"href":"/","className":"inline-block py-1 transition-colors duration-300 text-ivory/60 hover:text-ivory","children":"Home"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.25,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right h-3 w-3 text-ivory/40","aria-hidden":true,"children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}]]}],["$","li","/pure-pashmina-shawls",{"className":"flex items-center gap-1.5","children":["$","span",null,{"aria-current":"page","className":"text-ivory","children":"Pure Pashmina Shawls"}]}]]}]}],["$","p",null,{"className":"eyebrow mb-3 text-gold-soft","children":"Pure Pashmina"}],["$","h1",null,{"className":"font-serif text-[2.25rem] leading-[1.05] text-ivory md:text-[3.5rem]","children":"Pure Pashmina Shawls"}]]}]]}],["$","div",null,{"className":"container-luxe","children":[["$","div",null,{"className":"max-w-3xl py-14","children":[["$","p","\"Pure\" is the word that does the",{"className":"mt-5 text-[1.0625rem] leading-relaxed text-mocha first:mt-0","children":"\"Pure\" is the word that does the work here. Most cloth sold as pashmina is viscose, or wool carrying a token percentage of pashm. Pure Pashmina means the yarn is entirely Changthangi underfleece, hand-combed rather than shorn, and spun on a charkha rather than a mill frame."}]]}],"$L29"]}],"$L2a","$L2b","$L2c"]
