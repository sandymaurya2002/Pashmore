23:T7c5,{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://www.pashmore.com/craftsmanship#webpage","url":"https://www.pashmore.com/craftsmanship","name":"Craftsmanship","description":"How a Pashmore piece is made: hand-combing pashm in Ladakh, charkha spinning, handloom weaving, sozni and kani work, natural dyeing and certification.","isPartOf":{"@id":"https://www.pashmore.com/#website"},"inLanguage":"en-IN","about":{"@id":"https://www.pashmore.com/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.pashmore.com/"},{"@type":"ListItem","position":2,"name":"Craftsmanship","item":"https://www.pashmore.com/craftsmanship"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does one shawl take to make?","acceptedAnswer":{"@type":"Answer","text":"A plain pure Pashmina shawl takes roughly three months end to end — combing, dehairing, spinning, weaving and finishing. A fully embroidered sozni piece takes twelve to twenty-four months, and a full-field kani shawl up to two years."}},{"@type":"Question","name":"Do you use natural dyes?","acceptedAnswer":{"@type":"Answer","text":"Where the colour allows. Walnut husk, indigo, madder and turmeric are used for our heritage shades; deeper and more consistent tones use low-impact reactive dyes in small batches, which we say so on the product page."}},{"@type":"Question","name":"What is on the craft certificate?","acceptedAnswer":{"@type":"Answer","text":"The fibre grade in microns, the technique, the loom number, the date the piece came off the loom, and the name of the weaver or embroiderer who finished it."}},{"@type":"Question","name":"Are the artisans paid fairly?","acceptedAnswer":{"@type":"Answer","text":"We pay by the piece at rates agreed before work begins, directly to the family doing the work, with no intermediary. Handwork survives only where the people doing it can make a living from it."}}]}]}5:[["$","script",null,{"id":"craftsmanship-page","type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$23"}}],["$","div",null,{"className":"container-luxe pt-10","children":["$","nav",null,{"aria-label":"Breadcrumb","className":"$undefined","children":["$","ol",null,{"className":"flex flex-wrap items-center gap-1.5 text-[0.6875rem] uppercase tracking-[0.12em]","children":[["$","li","/",{"className":"flex items-center gap-1.5","children":[["$","$L15",null,{"href":"/","className":"inline-block py-1 transition-colors duration-300 text-taupe hover:text-charcoal","children":"Home"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.25,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right h-3 w-3 text-taupe/60","aria-hidden":true,"children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}]]}],["$","li","/craftsmanship",{"className":"flex items-center gap-1.5","children":["$","span",null,{"aria-current":"page","className":"text-charcoal","children":"Craftsmanship"}]}]]}]}]}],["$","header",null,{"className":"container-luxe max-w-3xl py-14","children":[["$","p",null,{"className":"eyebrow text-gold","children":"Craftsmanship"}],["$","h1",null,{"className":"mt-5 font-serif text-[2.25rem] leading-[1.05] text-charcoal md:text-[3.25rem]","children":"Four stages, three hundred kilometres, one shawl"}],["$","p",null,{"className":"mt-7 text-[1.0625rem] leading-relaxed text-mocha","children":"Between a Changthangi goat on the Ladakh plateau and a finished shawl in a box lie four distinct crafts, practised by four different sets of hands. None of them can be hurried, and every shortcut shows in the surface of the cloth."}]]}],"$L24","$L25","$L26","$L27"]
