25:["$","section",null,{"className":"border-t border-line bg-cream/40 py-20","aria-labelledby":"craft-faqs","children":["$","div",null,{"className":"container-luxe max-w-3xl","children":[["$","h2",null,{"id":"craft-faqs","className":"font-serif text-[1.75rem] leading-tight text-charcoal md:text-[2.25rem]","children":"Questions about how we work"}],["$","$L30",null,{"type":"single","collapsible":true,"className":"mt-8","children":[["$","$L31","How long does one shawl take to make?",{"value":"faq-0","children":[["$","$L32",null,{"children":"How long does one shawl take to make?"}],["$","$L33",null,{"children":"A plain pure Pashmina shawl takes roughly three months end to end — combing, dehairing, spinning, weaving and finishing. A fully embroidered sozni piece takes twelve to twenty-four months, and a full-field kani shawl up to two years."}]]}],["$","$L31","Do you use natural dyes?",{"value":"faq-1","children":[["$","$L32",null,{"children":"Do you use natural dyes?"}],["$","$L33",null,{"children":"Where the colour allows. Walnut husk, indigo, madder and turmeric are used for our heritage shades; deeper and more consistent tones use low-impact reactive dyes in small batches, which we say so on the product page."}]]}],["$","$L31","What is on the craft certificate?",{"value":"faq-2","children":[["$","$L32",null,{"children":"What is on the craft certificate?"}],["$","$L33",null,{"children":"The fibre grade in microns, the technique, the loom number, the date the piece came off the loom, and the name of the weaver or embroiderer who finished it."}]]}],["$","$L31","Are the artisans paid fairly?",{"value":"faq-3","children":[["$","$L32",null,{"children":"Are the artisans paid fairly?"}],["$","$L33",null,{"children":"We pay by the piece at rates agreed before work begins, directly to the family doing the work, with no intermediary. Handwork survives only where the people doing it can make a living from it."}]]}]]}]]}]}]
