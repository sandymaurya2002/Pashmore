# Canonical origin used for metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.pashmore.com

# Commerce backend. Leave unset to run entirely on the bundled demo catalogue.
# When set, src/services/* switches from the local repository to HTTP calls.
NEXT_PUBLIC_API_BASE_URL=
API_TOKEN=

# Payments (Razorpay). Client key is public by design; secret is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional analytics / verification
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# Admin tools (/admin/keywords). Off in production unless set. There is no
# auth yet: protect /admin at the edge before enabling this publicly.
ENABLE_ADMIN=
