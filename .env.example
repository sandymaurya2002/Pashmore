# Canonical origin used for metadataBase, canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.pashmore.com

# ---------------------------------------------------------------------------
# Cloudflare Worker API (server-side only — never prefix with NEXT_PUBLIC_).
# The browser only talks to this app's /api/* route handlers; those call the
# Worker, which owns D1 and R2. `/api/v1` is appended automatically.
# Required in production: the Vercel production build fails without it.
# ---------------------------------------------------------------------------
CLOUDFLARE_API_URL=https://api.pashmore.com

# Public R2 domain (custom domain or r2.dev) for images returned as bare object
# keys. Absolute image URLs from this host and the Worker host are allowed.
CLOUDFLARE_R2_PUBLIC_URL=https://media.pashmore.com
# Extra comma-separated hostnames allowed for product imagery (optional).
IMAGE_REMOTE_HOSTS=

# Optional: Cloudflare Access service token if the Worker sits behind Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Must equal the Worker's GATEWAY_SECRET. Lets the Worker trust the shopper IP
# this app forwards, so its per-IP rate limits (sign-in, register, order
# tracking) apply per shopper instead of to every request from Vercel.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLOUDFLARE_GATEWAY_SECRET=

# Shared secret for POST /api/revalidate (purges cached catalogue data).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Optional analytics / verification
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# Admin tools (/admin/keywords). Off in production unless set. There is no
# auth yet: protect /admin at the edge before enabling this publicly.
ENABLE_ADMIN=
